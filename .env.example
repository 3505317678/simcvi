# ---------------------------------------------------------------------------
# SIMCVI · Variables de entorno
#
# No edite este archivo para poner secretos: ejecute
#   Linux / macOS / Git Bash:  ./scripts/init-env.sh
#   Windows PowerShell:        .\scripts\init-env.ps1
# y se creará .env con contraseñas y tokens aleatorios. El archivo .env
# está en .gitignore: nunca lo suba al repositorio.
# ---------------------------------------------------------------------------

# Zona horaria de los contenedores
TZ=America/Bogota

# --- InfluxDB 2.9 (configuración inicial; solo se aplica la primera vez) ---
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=
INFLUX_ADMIN_TOKEN=
INFLUX_ORG=simcvi
INFLUX_BUCKET=simcvi
# Retención del bucket en horas: 720h = 30 días. Solo se aplica en la primera ejecución.
INFLUX_RETENTION=720h

# Tokens que usan Node-RED (escritura) y Grafana (lectura).
# init-env los iguala al token de administración para el arranque rápido.
# Para aplicar mínimo privilegio, reemplácelos según README, sección «Tokens de mínimo privilegio».
NODERED_INFLUX_TOKEN=
GRAFANA_INFLUX_TOKEN=

# --- Node-RED 5 (editor en http://localhost:1880/admin) ---
NR_ADMIN_USER=admin
NR_ADMIN_PASSWORD=
NR_CREDENTIAL_SECRET=

# --- Grafana 13 ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Dirección con la que el navegador abre Grafana (se embebe en la interfaz de SIMCVI).
# Si la cambia, actualice también frame-src en ui/index.html.
GRAFANA_PUBLIC_URL=http://localhost:3000

# --- Proceso simulado (valores iniciales; se cambian en la vista Ajustes) ---
SIM_ZONAS=4
SIM_INTERVALO_SEG=2
SIM_PROB_ANOMALIA_PCT=4
SIM_PROB_INCENDIO_PCT=0
SIM_AUTOINICIO=true
