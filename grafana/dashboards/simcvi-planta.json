            "type": "influxdb",
            "uid": "simcvi-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"planta\" and r._field == \"emergencia\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: if r._value then 1 else 0}))"
