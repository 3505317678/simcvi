          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"caudal\")\n  |> filter(fn: (r) => contains(value: r.zona, set: ${zona:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, serie: \"Zona \" + r.zona}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"serie\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])"
