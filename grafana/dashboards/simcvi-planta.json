    {
      "id": 7,
      "type": "timeseries",
      "title": "Presión",
      "description": "Promedio por ventana de presion en las zonas seleccionadas. Las líneas discontinuas son los límites configurados en SIMCVI.",
      "datasource": {
        "type": "influxdb",
        "uid": "simcvi-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "simcvi-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetria\" and r._field == \"presion\")\n  |> filter(fn: (r) => contains(value: r.zona, set: ${zona:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, serie: \"Zona \" + r.zona}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"serie\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "simcvi-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"limites\" and r.variable == \"presion\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, serie: if r._field == \"min\" then \"Límite mínimo\" else \"Límite máximo\"}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"serie\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pressurebar",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
